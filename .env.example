# Backend
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://pharmalink:pharmalink@localhost:55432/pharmalink
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Storage
USE_S3=false
PRODUCT_IMAGE_BASE_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
MAX_PRESCRIPTION_FILE_SIZE_MB=10
MAX_IMPORT_FILE_SIZE_MB=5

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# Security
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
# Only take effect when DJANGO_DEBUG=false; see docs/DEPLOY_AWS.md
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000

# WhatsApp (apps.messaging) - leave WHATSAPP_PROVIDER=console for dev/test, no account needed
WHATSAPP_PROVIDER=console
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_TEMPLATE_ORDER_STATUS=pharmalink_order_status_v1
WHATSAPP_TEMPLATE_REFILL_REMINDER=pharmalink_refill_reminder_v1
WHATSAPP_TEMPLATE_PHARMACY_ALERT=pharmalink_pharmacy_alert_v1
WHATSAPP_TEMPLATE_PRESCRIPTION_EXPIRY=pharmalink_prescription_expiry_v1
WHATSAPP_TEMPLATE_RENEWAL_DECISION=pharmalink_renewal_decision_v1
WHATSAPP_TEMPLATE_PAYMENT_FAILED=pharmalink_payment_failed_v1

# Patient prescription SMS (apps.messaging.sms) - when a doctor issues a prescription it is
# texted to the patient's phone alongside the email. Leave SMS_PROVIDER=console for dev/test
# (logs, no AWS account). Set SMS_PROVIDER=aws_sns to send via AWS SNS Publish; boto3 uses the
# same AWS credentials as S3 (env or task role). SMS_SENDER_ID is the alphanumeric originator
# carriers display; in markets like Lebanon it is what makes a shared-route message
# deliverable at all. Max 11 alphanumeric chars, ignored where unsupported (US/CA). See
# docs/DEPLOY_AWS.md.
SMS_PROVIDER=console
SMS_SENDER_ID=HlthConnect
AWS_SNS_REGION_NAME=eu-central-1
# AWS SNS shared routes do NOT deliver to some countries at all (Lebanon among them).
# For those, set SMS_PROVIDER=twilio and fill these in (Twilio has direct carrier coverage).
# TWILIO_FROM is an SMS-capable Twilio number in E.164, or a Messaging Service SID ("MG...").
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Email delivery - default is the console backend (prints to the log, no account). Point
# EMAIL_HOST/EMAIL_HOST_USER/EMAIL_HOST_PASSWORD at an SMTP host, OR set
# EMAIL_BACKEND=apps.common.email_backends.SESEmailBackend to send through AWS SES with no
# SMTP secret (boto3 credentials, AWS_SES_REGION_NAME selects the region). The sender identity
# in DEFAULT_FROM_EMAIL must be verified in SES. See docs/DEPLOY_AWS.md.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
AWS_SES_REGION_NAME=eu-central-1
SES_CONFIGURATION_SET=

# Pharmacy analytics narrative digest (apps.analytics) - leave ANALYTICS_AI_PROVIDER=none for
# dev/test; the digest falls back to the existing rule-based Smart Insights cards with no
# external call. Point it at "openai_compatible" + a base URL/key/model to narrate over any
# OpenAI-compatible gateway (OpenRouter, OpenCode Zen's /chat/completions-family models,
# a local Ollama server, ...). See docs/AI_FEATURES.md §5.
ANALYTICS_AI_PROVIDER=none
ANALYTICS_AI_BASE_URL=
ANALYTICS_AI_API_KEY=
ANALYTICS_AI_MODEL=

# In-app assistant (apps.assistant) - the keyword router (free, offline) always runs first and
# is all that's needed for ASSISTANT_PARSER=keyword (the default). Point ASSISTANT_PARSER at
# "openrouter" with a base URL/key/model to add an OpenAI-compatible fallback for messages
# keywords can't classify, and to turn on the composer that writes replies from tool data
# instead of the fixed template - every composed reply is checked against that data before it
# ships and falls back to the template on any doubt. See config/settings.py.
ASSISTANT_PARSER=keyword
ASSISTANT_BASE_URL=https://openrouter.ai/api/v1
ASSISTANT_API_KEY=
ASSISTANT_MODEL=

# Optional
SENTRY_DSN=
